{
  "name": "ML Zoomcamp",
  "image": "mcr.microsoft.com/devcontainers/miniconda:1-3",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/ml-zoomcamp/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  }
}